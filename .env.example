# Copy to .env and fill in before: docker compose up --build

# Demo UI users (mapped in application.yml → cdp.users)
RECRUITER_USERNAME=recruiter
RECRUITER_PASSWORD=demo

# Required — use strong unique values in any hosted environment
WEBHOOK_SECRET=change-me-webhook-secret
PII_HASH_SALT=change-me-pii-salt

SPRING_AI_OPENAI_API_KEY=sk-your-key-here

CDP_PORT=8080
DB_USERNAME=sa
DB_PASSWORD=

# Optional GitHub OAuth — BOTH client credentials AND allowlist required
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins and/or emails permitted to sign in
GITHUB_ALLOWED_LOGINS=